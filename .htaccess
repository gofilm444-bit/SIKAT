Options -Indexes

<Files ".env">
  Require all denied
</Files>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<FilesMatch "^(db|config_mail)\.php$">
  Require all denied
</FilesMatch>

<FilesMatch "(?i)_helpers\.php$">
  Require all denied
</FilesMatch>

<FilesMatch "(?i)\.(sql|log|bak|zip|rar|7z|tar|gz)$">
  Require all denied
</FilesMatch>
<FilesMatch "(?i)\.md$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(db|vendor|config|storage_sql_backup|storage)/ - [F,L]
</IfModule>
